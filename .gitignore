# Python
__pycache__/
.venv/

# Build artifacts
build/
dist/
*.egg-info/

# Tools
.pytest_cache/
.ruff_cache/

# Streamlit — ignore local cache/secrets, but ship the committed config
.streamlit/*
!.streamlit/config.toml

# Streamlit's skills install (the app-load "Help agents write better apps" toast,
# and since 1.62 an "Install skills" button under errors Streamlit itself raises)
# links agent skills into the project: .agents/skills always, and .claude/skills
# when Claude Code is detected — the latter already covered by `.claude/*` below
.agents/

# Claude Code — ignore per-user overrides, but ship the shared guardrails
.claude/*
!.claude/settings.json

# Generated audio (the app produces downloadable WAV output)
*.wav

# macOS
.DS_Store

# Notebooks
.ipynb_checkpoints/
*.ipynb

# Docs
docs/

# Secrets
.env
.env.*
